{
  "$schema": "https://rinbarpen.dev/schemas/agent-preset-v1.json",
  "name": "deepseek-default",
  "displayName": "OmniRoute Auto Default",
  "description": "All agents use OmniRoute routing with cache optimizations enabled",
  "version": 1,
  "provider": {
    "defaultProvider": "omniroute"
  },
  "agents": {
    "claude-code": {
      "enabled": true,
      "model": "auto",
      "planModel": "auto",
      "permissionMode": "acceptEdits"
    },
    "codex": {
      "enabled": true,
      "model": "auto",
      "planModel": "auto",
      "reasoningEffort": "medium",
      "planReasoningEffort": "xhigh",
      "approvalPolicy": "on-request"
    },
    "opencode": {
      "enabled": true,
      "model": "omniroute/auto",
      "planModel": "omniroute/auto",
      "reasoningEffort": "xhigh"
    },
    "pi": {
      "enabled": true,
      "model": "omniroute/auto",
      "provider": "omniroute",
      "maxTokens": 1000000,
      "cache": { "consistentPrompt": true }
    },
    "omp": {
      "enabled": true,
      "model": "omniroute/auto",
      "provider": "omniroute",
      "features": {
        "hashAnchoredEdits": true,
        "snapcompact": true,
        "lsp": false,
        "dap": false
      }
    }
  },
  "mcp": {
    "scenarios": ["daily", "chat"]
  }
}
